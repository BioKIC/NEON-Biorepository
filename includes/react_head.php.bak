if ($isLoggedIn) {
    $buttons[] = ['My Account', $isNeonMode
        ? 'https://data.neonscience.org/myaccount'
        : $CLIENT_ROOT . '/profile/viewprofile.php'];
    $buttons[] = ['Sign Out', $CLIENT_ROOT . '/profile/index.php?submit=logout'];
} else {
    $buttons[] = ['Sign In', $CLIENT_ROOT . ($isNeonMode
        ? '/profile/openIdAuth.php'
        : '/profile/index.php')];
}

if ($isNeonEditor) {
    $buttons[] = ['Management Tools', $CLIENT_ROOT . '/neon/index.php'];
    $buttons[] = ['Sitemap', $CLIENT_ROOT . '/sitemap.php'];
}
