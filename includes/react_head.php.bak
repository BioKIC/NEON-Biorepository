<script>
    document.addEventListener('DOMContentLoaded', () => {
        const innerText = document.getElementById('innertext');
        if (!innerText || document.getElementById('biorepo-page')) return;

        const biorepoPage = document.createElement('div');
        biorepoPage.id = 'biorepo-page';
        innerText.before(biorepoPage);
    });

    window.addEventListener('biorepo:neon-page-ready', () => {
        function updateElementWidth() {
            const blueDiv = document.getElementById('blue-div');
            if (!blueDiv) return;

            const content = document.querySelector('[data-selenium="neon-page.content"]');
            const container = document.querySelector('.MuiContainer-root');
            const innerText = document.getElementById('innertext');
            const statistics = document.getElementById('statistics-container');
            if (!content || !container || !innerText || !statistics) return;

            const padding = parseFloat(getComputedStyle(content).paddingLeft);
            const margin = parseFloat(getComputedStyle(innerText).marginLeft);
            const rightMargin = parseFloat(getComputedStyle(container).marginRight);
            const right = `${padding + margin}px`;

            blueDiv.style.width = `${content.offsetWidth + rightMargin}px`;
            blueDiv.style.right = right;
            statistics.style.width = `${content.offsetWidth - 2 * padding}px`;
            statistics.style.right = right;
        }

        function updateBreadcrumbHash() {
            const link = document.querySelector('nav a[href="../misc/neoncollprofiles.php?collid=#"]');
            if (link) link.href = link.href.replace('#', <?= json_encode(isset($collid) ? $collid : '#') ?>);
        }

        function waitForElement(selector, callback) {
            if (document.querySelector(selector)) {
                callback();
                return;
            }

            const observer = new MutationObserver(() => {
                if (!document.querySelector(selector)) return;
                observer.disconnect();
                callback();
            });
            observer.observe(document.body, { childList: true, subtree: true });
        }

        waitForElement('.neon__sidebar-sticky', () => {
            updateElementWidth();
            updateBreadcrumbHash();
        });
        window.addEventListener('resize', updateElementWidth);

        <?php if (empty($DEACTIVATE_REACT)): ?>
        const logoLink = document.getElementById('block-neon-site-branding');
        if (logoLink) logoLink.href = 'https://www.neonscience.org/';

        const innerText = document.getElementById('innertext');
        const target = document.querySelector('[data-selenium="neon-page.content"]');
        if (innerText && target) target.appendChild(innerText);

        // Remove legacy navigation and footer.
        ['top_navbar', 'main-header', 'main-footer'].forEach(id => {
            document.getElementById(id)?.remove();
        });
        document.querySelector('.navpath')?.remove();

        // Add the Symbiota credit and issue-reporting link to the footer.
        const footerMessage = document.querySelector('.footer-bottom__message');
        if (footerMessage) {
            const wrapper = document.createElement('div');
            Object.assign(wrapper.style, {
                display: 'flex', justifyContent: 'space-between', width: '100%'
            });

            const credit = document.createElement('p');
            credit.append('Site powered by ');
            const symbiotaLink = document.createElement('a');
            symbiotaLink.href = 'https://symbiota.org/';
            symbiotaLink.textContent = 'Symbiota';
            credit.append(symbiotaLink, ' | ');
            const analytics = document.createElement('i');
            analytics.textContent = 'This site uses Google Analytics';
            credit.append(analytics);

            const report = document.createElement('div');
            Object.assign(report.style, {
                display: 'flex', justifyContent: 'flex-end', alignItems: 'center', flex: '1'
            });
            const reportLink = document.createElement('a');
            reportLink.href = 'https://github.com/BioKIC/NEON-Biorepository/issues';
            Object.assign(reportLink.style, {
                textDecoration: 'none', color: 'inherit',
                display: 'flex', alignItems: 'center'
            });
            const githubLogo = document.createElement('img');
            githubLogo.src = <?= json_encode($CLIENT_ROOT . '/images/icons/github-mark-white.svg') ?>;
            githubLogo.alt = 'GitHub Logo';
            Object.assign(githubLogo.style, {
                width: '16px', height: '16px', marginRight: '5px'
            });
            reportLink.append(githubLogo, 'Report a problem');
            report.append(reportLink);
            wrapper.append(credit, report);
            footerMessage.append(wrapper);
        }

        // Footer logos.
        const footerLogos = document.querySelector('.footer-top__logo');
        if (footerLogos) {
            function addFooterLogo(src, href) {
                const link = document.createElement('a');
                link.href = href;
                link.target = '_blank';
                const img = document.createElement('img');
                Object.assign(img, { src, height: 60, width: 167 });
                link.append(img);
                footerLogos.append(link);
            }

            addFooterLogo(
                <?= json_encode($CLIENT_ROOT . '/images/layout/logo_symbiota_white_text.png') ?>,
                'https://symbiota.org/'
            );
            addFooterLogo(
                <?= json_encode($CLIENT_ROOT . '/images/layout/logo-asu-biokic.jpg') ?>,
                'https://biokic.asu.edu/collections'
            );
        }

        // Display a temporary notification only within the configured date range.
        (() => {
            const now = new Date();
            const start = new Date('2026-03-30T00:00:00-04:00');
            const end = new Date('2026-04-02T02:00:00-04:00');
            if (now < start || now > end) return;

            const header = document.querySelector('header');
            if (!header || document.getElementById('neon-dev-banner')) return;

            const banner = document.createElement('div');
            banner.id = 'neon-dev-banner';
            banner.setAttribute('role', 'status');
            banner.setAttribute('aria-live', 'polite');
            Object.assign(banner.style, { background: '#FFCB4F', padding: '12px 16px' });

            const message = document.createElement('p');
            Object.assign(message.style, {
                margin: '0 auto', maxWidth: '1652px', boxSizing: 'border-box',
                color: '#000', lineHeight: '1.5', fontSize: '.95rem'
            });
            message.textContent = 'The primary NEON website, www.neonscience.org, is currently down. We are working on a solution and hope to have this resolved shortly. Thank you for your patience.';
            banner.append(message);
            header.insertAdjacentElement('afterend', banner);
        })();

        // Authentication and management buttons.
        const headerButtons = <?= json_encode($buttons, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

        function addHeaderButtons() {
            const container = document.getElementById('header__authentication-ui');
            if (!container) return;

            container.querySelectorAll('.symb-header-button').forEach(el => el.remove());
            const fragment = document.createDocumentFragment();

            headerButtons.forEach(([label, url]) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'symb-header-button MuiButtonBase-root MuiButton-root MuiButton-outlined MuiButton-outlinedPrimary MuiButton-outlinedSizeSmall MuiButton-sizeSmall';
                button.textContent = label;
                button.addEventListener('click', () => window.location.assign(url));
                fragment.append(button);
            });

            container.prepend(fragment);
        }

        // The React header may not exist when this event first fires.
        waitForElement('#header__authentication-ui', addHeaderButtons);
        <?php endif; ?>
    });
</script>

<script>
(function () {
    const muiStyles = new Map();
    const muiSelector = '[class*="Mui"]';

    function isReactElement(el) {
        return Object.keys(el).some(key =>
            key.startsWith('__reactFiber$') || key.startsWith('__reactInternalInstance$')
        );
    }

    function getKey(el) {
        const classes = [...el.classList].filter(c => c.startsWith('Mui')).sort();
        return classes.length ? `${el.tagName}|${classes.join('|')}` : null;
    }

    function collectStyles() {
        document.querySelectorAll(muiSelector).forEach(el => {
            if (!isReactElement(el)) return;

            const key = getKey(el);
            const cssClasses = [...el.classList].filter(c => c.startsWith('css-'));
            if (!key || !cssClasses.length) return;

            const variables = {};
            for (const prop of el.style) {
                if (prop.startsWith('--')) variables[prop] = el.style.getPropertyValue(prop);
            }
            muiStyles.set(key, { cssClasses, variables });
        });
    }

    function applyStyles() {
        document.querySelectorAll(muiSelector).forEach(el => {
            if (isReactElement(el)) return;

            const styles = muiStyles.get(getKey(el));
            if (!styles) return;

            [...el.classList].filter(c => c.startsWith('css-')).forEach(c => el.classList.remove(c));
            el.classList.add(...styles.cssClasses);

            for (const [prop, value] of Object.entries(styles.variables)) {
                el.style.setProperty(prop, value);
            }
        });
    }

    function init() {
        let scheduled = false;
        const options = { childList: true, subtree: true };

        const update = () => {
            collectStyles();
            applyStyles();
        };

        const observer = new MutationObserver(() => {
            if (scheduled) return;
            scheduled = true;

            requestAnimationFrame(() => {
                scheduled = false;
                observer.disconnect();
                update();
                observer.observe(document.documentElement, options);
            });
        });

        update();
        observer.observe(document.documentElement, options);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>